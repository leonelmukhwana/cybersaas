<UserControl x:Class="CyberSaaS.Terminal.UI.Views.TerminalLockedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource CyberPrimaryBrush}"
                Padding="32,20">

            <Grid>

                <TextBlock Text="CyberSaaS"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBlock Text="TERMINAL"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Opacity="0.85"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- Main locked area -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <StackPanel Width="480"
                        HorizontalAlignment="Center">

                <!-- Lock icon -->
                <Border Width="110"
                        Height="110"
                        CornerRadius="55"
                        Background="{StaticResource CyberLightBlueBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,28">

                    <TextBlock Text="🔒"
                               FontSize="52"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                </Border>

                <TextBlock Text="Terminal Locked"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CyberTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="This computer is ready for the next customer."
                           FontSize="16"
                           Foreground="{StaticResource CyberMutedTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,28"/>

                <!-- Information -->
                <Border Background="{StaticResource CyberLightBlueBrush}"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,24">

                    <StackPanel>

                        <TextBlock Text="Customer verification required"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Verify the customer before starting a session."
                                   FontSize="13"
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Start verification -->
                <Button Content="Start Customer Verification"
                        Width="260"
                        Height="48"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CyberPrimaryButton}"
                        Click="StartVerificationButton_Click"/>

            </StackPanel>

        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="{StaticResource CyberBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">

            <TextBlock Text="CyberSaaS Terminal • Secure workstation"
                       FontSize="12"
                       Foreground="{StaticResource CyberMutedTextBrush}"
                       HorizontalAlignment="Center"/>

        </Border>

    </Grid>

</UserControl>