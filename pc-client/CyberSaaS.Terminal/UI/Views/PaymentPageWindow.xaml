<Window x:Class="CyberSaaS.Terminal.PaymentPageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete Payment"
        Width="520"
        Height="520"
        MinWidth="520"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Complete Payment"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource CyberPrimaryBrush}"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    Margin="0,25,0,25"
                    HorizontalAlignment="Center">

            <TextBlock Text="Amount Due"
                       FontSize="14"
                       Foreground="{StaticResource CyberMutedTextBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="AmountTextBlock"
                       Text="KES 0.00"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{StaticResource CyberPrimaryBrush}"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="StatusTextBlock"
                       Text="Select a payment method"
                       FontSize="13"
                       Foreground="{StaticResource CyberMutedTextBrush}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center">

            <Button x:Name="CashButton"
                    Content="💵  Cash"
                    Height="58"
                    Margin="0,0,0,15"
                    FontSize="17"
                    Style="{StaticResource CyberPrimaryButton}"
                    Click="CashButton_Click"/>

            <Button x:Name="MpesaButton"
                    Content="📱  M-Pesa"
                    Height="58"
                    FontSize="17"
                    Style="{StaticResource CyberSecondaryButton}"
                    Click="MpesaButton_Click"/>

            <TextBlock x:Name="OfflineNoticeTextBlock"
                       Text="M-Pesa requires an internet connection."
                       FontSize="12"
                       Foreground="{StaticResource CyberMutedTextBrush}"
                       Margin="0,18,0,0"
                       TextAlignment="Center"
                       Visibility="Collapsed"/>

        </StackPanel>

        <Button Grid.Row="3"
                Content="Cancel"
                Width="100"
                Height="38"
                HorizontalAlignment="Center"
                Margin="0,25,0,0"
                Style="{StaticResource CyberSecondaryButton}"
                Click="CancelButton_Click"/>

    </Grid>
</Window>