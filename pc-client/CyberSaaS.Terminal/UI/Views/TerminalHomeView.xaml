
<UserControl x:Class="CyberSaaS.Terminal.UI.Views.TerminalHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource CyberPrimaryBrush}"
                Padding="24">

            <Grid>

                <StackPanel>
                    <TextBlock Text="CyberSaaS"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Computer Terminal"
                               FontSize="14"
                               Foreground="#DCEBFF"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right">

                    <TextBlock Text="🟢 ONLINE"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="Terminal ready"
                               FontSize="13"
                               Foreground="#DCEBFF"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="32"
                        HorizontalAlignment="Center"
                        MaxWidth="700">

                <TextBlock Text="Welcome"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyberTextBrush}"
                           Margin="0,20,0,8"/>

                <TextBlock Text="This computer is ready for a customer session."
                           FontSize="16"
                           Foreground="{StaticResource CyberMutedTextBrush}"
                           Margin="0,0,0,32"/>

                <!-- Terminal Information -->
                <Border Padding="24"
                        Background="{StaticResource CyberLightBlueBrush}"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="🖥️ Terminal Information"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   Margin="0,0,0,18"/>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Terminal Code"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CyberTextBrush}"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="TERM-XXXXXXXXXXXX"
                                       Foreground="{StaticResource CyberTextBrush}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Connection"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CyberTextBrush}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="Online"
                                       Foreground="{StaticResource CyberTextBrush}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Control State"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CyberTextBrush}"
                                       Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="Unlocked"
                                       Foreground="{StaticResource CyberTextBrush}"
                                       Margin="0,12,0,0"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Session -->
                <Border Padding="24"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">

                    <StackPanel>

                        <TextBlock Text="👤 Customer Session"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="No active session"
                                   FontSize="16"
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   Margin="0,0,0,20"/>

                        <Button Content="Start Session"
                                Height="48"
                                FontSize="16"
                                Style="{StaticResource CyberPrimaryButton}"
                                Click="StartSessionButton_Click"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="16"
                BorderBrush="{StaticResource CyberBorderBrush}"
                BorderThickness="0,1,0,0">

            <TextBlock Text="CyberSaaS Terminal"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource CyberMutedTextBrush}"
                       FontSize="12"/>

        </Border>

    </Grid>

</UserControl>
