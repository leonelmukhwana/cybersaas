
<UserControl x:Class="CyberSaaS.Terminal.UI.Views.TerminalRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="White">

        <Border Width="520"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{StaticResource CyberBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel>

                <TextBlock Text="CyberSaaS"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyberPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Terminal Registration"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CyberTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,8"/>

                <TextBlock Text="Enter the enrollment key provided by your Cyber Owner or attendant."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource CyberMutedTextBrush}"
                           FontSize="14"
                           Margin="20,0,20,30"/>

                <TextBlock Text="Enrollment Key"
                           Foreground="{StaticResource CyberTextBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="LicenceKeyTextBox"
                         Height="46"
                         FontSize="16"/>

                <Button x:Name="RegisterButton"
                        Content="Register Computer"
                        Height="46"
                        Margin="0,20,0,0"
                        FontSize="16"
                        Style="{StaticResource CyberPrimaryButton}"
                        Click="RegisterButton_Click"/>

                <TextBlock x:Name="StatusTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource CyberMutedTextBrush}"
                           Margin="0,20,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
