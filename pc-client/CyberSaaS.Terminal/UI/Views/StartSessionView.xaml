<UserControl x:Class="CyberSaaS.Terminal.UI.Views.StartSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Width="650"
                        HorizontalAlignment="Center"
                        Margin="32">

                <TextBlock Text="Start Session"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyberTextBrush}"/>

                <TextBlock Text="Verify the customer and choose the session type."
                           FontSize="15"
                           Foreground="{StaticResource CyberMutedTextBrush}"
                           Margin="0,6,0,25"/>

                <!-- CUSTOMER -->

                <Border Padding="24"
                        Background="{StaticResource CyberLightBlueBrush}"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Customer"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   Margin="0,0,0,16"/>

                        <TextBlock x:Name="CustomerNameTextBlock"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyberPrimaryBrush}"/>

                        <TextBlock x:Name="CustomerPhoneTextBlock"
                                   FontSize="14"
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   Margin="0,6,0,0"/>

                        <TextBlock x:Name="CustomerIdTextBlock"
                                   FontSize="13"
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

                <!-- SESSION TYPE -->

                <Border Padding="24"
                        Background="{StaticResource CyberLightBlueBrush}"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Session Type"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   Margin="0,0,0,18"/>

                        <RadioButton x:Name="AdultSessionRadio"
                                     Content="Pay After"
                                     FontSize="16"
                                     IsChecked="True"
                                     Margin="0,0,0,8"/>

                        <TextBlock Text="Customer uses the computer first. The amount is calculated from the branch billing settings."
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="28,0,0,20"/>

                        <RadioButton x:Name="PrepaidSessionRadio"
                                     Content="Prepaid / Pay Before"
                                     FontSize="16"/>

                        <TextBlock Text="Customer pays before using the computer."
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="28,6,0,0"/>

                    </StackPanel>

                </Border>

                <!-- PAY AFTER -->

                <Border x:Name="AdultSessionPanel"
                        Padding="24"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Pay After"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"/>

                        <TextBlock Text="The CyberSaaS server will calculate the amount due using the branch billing configuration."
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- PREPAID -->

                <Border x:Name="PrepaidSessionPanel"
                        Padding="24"
                        BorderBrush="{StaticResource CyberBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Prepaid / Pay Before"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Enter the amount the customer has paid. The system will calculate the available minutes using the branch billing rate."
                                   Foreground="{StaticResource CyberMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Amount Paid"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberTextBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="PrepaidAmountTextBox"
                                 Height="46"
                                 FontSize="15"/>

                    </StackPanel>

                </Border>

                <Button x:Name="StartButton"
                        Content="Start Session"
                        Height="50"
                        FontSize="16"
                        Style="{StaticResource CyberPrimaryButton}"
                        Click="StartButton_Click"/>

                <Button Content="Cancel"
                        Height="44"
                        FontSize="15"
                        Margin="0,10,0,0"
                        Style="{StaticResource CyberSecondaryButton}"
                        Click="CancelButton_Click"/>

                <TextBlock x:Name="StatusTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource CyberMutedTextBrush}"
                           Margin="0,20,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>